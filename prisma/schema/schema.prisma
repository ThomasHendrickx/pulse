// Prisma schema folder layout: one schema file per module, so the module
// owning a table also owns its schema (architecture section 3). This file
// carries only the datasource and generator.
//
// Connection string rule (hazard H0.3): runtime queries go over the POOLED
// string (DATABASE_URL); migrations go over the DIRECT string (DIRECT_URL).
// Prisma reads directUrl for migrate commands automatically.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
