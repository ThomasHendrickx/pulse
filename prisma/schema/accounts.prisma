// Accounts module tables (declaration layer). The user declares an account
// at first sight: label, bank, and its ring (pot or reserve). Never
// inferred, never defaulted (pulse-domain section 1).

enum AccountRole {
  POT
  RESERVE
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  householdId String      @db.Uuid
  label       String
  bank        String
  role        AccountRole
  // The account's own IBAN, when the source files carry one (current
  // account exports do). Card exports carry no IBAN: those accounts are
  // recognised through their bound SourceProfile instead, so iban is
  // optional. Unique per household where present.
  iban        String?
  createdAt   DateTime    @default(now())

  household      Household       @relation(fields: [householdId], references: [id])
  sourceProfiles SourceProfile[]
  imports        Import[]
  transactions   Transaction[]

  @@unique([householdId, iban])
  @@index([householdId])
  @@map("accounts")
}
