# Pulse environment template. Copy to .env for local development.
#
# Connection string rule (architecture section 3): runtime uses the POOLED
# connection string (DATABASE_URL), migrations use the DIRECT connection
# string (DIRECT_URL). Locally both point at the same `supabase start`
# Postgres. On Vercel against a deployed Supabase project:
#   DATABASE_URL  = the pooled string (port 6543, pgbouncer)
#   DIRECT_URL    = the direct string (port 5432)
# Running migrations over the pooled string is the most common way this
# stack breaks on first deploy. Never do it.

DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Auth (email and password only; no OAuth, no magic links).
# Local values come from the `supabase start` output.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server side only. Used by prisma/seed.ts to create the seeded dev user in
# Supabase Auth. Never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Seeded local development login (one household, one user).
SEED_USER_EMAIL="dev@pulse.local"
SEED_USER_PASSWORD="pulse-dev-password"
