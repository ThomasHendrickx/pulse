{
  "name": "pulse",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gate:tokens": "! grep -rE 'oklch\\(|#[0-9a-fA-F]{3,8}|font-size:\\s*[0-9.]+px' src/modules/*/ui",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:reset": "tsx src/platform/db/guard-cli.ts && prisma migrate reset --force",
    "db:migrate": "tsx src/platform/db/guard-cli.ts && prisma migrate dev"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tiphys/kernel": "0.1.0",
    "next": "^15.5.3",
    "next-intl": "^4.3.6",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.55.0",
    "@prisma/internals": "^6.16.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "fast-check": "^4.9.0",
    "prisma": "^6.16.2",
    "supabase": "^2.40.7",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.0": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "supabase@2.114.0": true
  }
}
